{
  "appId": "com.bubt.marksportal",
  "appName": "BUBT Marks Portal",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ],
      "smallIcon": "ic_stat_bubt",
      "iconColor": "#4F46E5"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert",
        "banner",
        "list"
      ]
    }
  }
}
