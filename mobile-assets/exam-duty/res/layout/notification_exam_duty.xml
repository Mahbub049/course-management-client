<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/exam_duty_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_exam_duty_notification">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TODAY’S EXAM DUTY"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#DCE8FF"
        android:letterSpacing="0.07" />
    <TextView
        android:id="@+id/duty_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Saturday, 24 Oct 2026"
        android:textSize="12sp"
        android:textColor="#AABDDD" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="◷  TIME"
                android:textSize="11sp"
                android:textColor="#A7BFEB" />
            <TextView
                android:id="@+id/duty_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10:00 AM"
                android:textSize="27sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="19sp"
                android:autoSizeMaxTextSize="27sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        <View
            android:layout_width="1dp"
            android:layout_height="45dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="12dp"
            android:background="#465572" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="●  ROOM"
                android:textSize="11sp"
                android:textColor="#A7BFEB" />
            <TextView
                android:id="@+id/duty_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="A-401"
                android:textSize="25sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="25sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/duty_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#BBC9DE" />
    <TextView
        android:id="@+id/duty_acknowledge"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:gravity="center"
        android:text="✓   Acknowledge"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_exam_duty_ack" />
</LinearLayout>
